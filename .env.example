EXCHANGE_BYBIT_API_KEY=
EXCHANGE_BYBIT_SECRET_KEY=

# true — подключаться к Demo Trading (api-demo.bybit.com) вместо боевой торговли.
EXCHANGE_BYBIT_DEMO=false
# Ключи для Demo Trading — создаются отдельно, в разделе "Demo Trading" аккаунта Bybit.
# Ключи для боевой торговли (выше) там не подойдут. Нужны только если EXCHANGE_BYBIT_DEMO=true.
EXCHANGE_BYBIT_DEMO_API_KEY=
EXCHANGE_BYBIT_DEMO_SECRET_KEY=